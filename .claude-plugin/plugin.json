{
  "name": "clauding",
  "version": "1.1.0",
  "description": "Discord Rich Presence for Claude Code: crab icon, model and live token counts. Customizable, zero dependencies.",
  "author": { "name": "nishaj0", "url": "https://github.com/nishaj0" },
  "repository": "https://github.com/nishaj0/clauding",
  "license": "MIT",
  "keywords": ["discord", "rich-presence", "status", "claude-code"],
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/presence.js\"", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/presence.js\"", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/presence.js\"", "timeout": 10 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/presence.js\"", "timeout": 5 }] }]
  }
}
